---
import white from '../assets/brand/ns_mark_white.svg';
import violet from '../assets/brand/ns_mark_violet.svg';
---

<!-- Pointy-top and regular: 400 x 440 box, so width : height is 0.866 : 1 like the hexagons on the covers. -->
<div class="kit-hexmark" aria-hidden="true">
  <svg viewBox="0 0 400 440"><polygon points="200,12 380.1,116 380.1,324 200,428 19.9,324 19.9,116"></polygon></svg>
  <img class="kit-hexmark-dark" src={white.src} alt="" width="94" height="75" />
  <img class="kit-hexmark-light" src={violet.src} alt="" width="94" height="75" />
</div>
