---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { pages, groups, addressOf, byLabel } from '../../tools/pages.mjs';

const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.jpg', { eager: true });

// Same order as the sidebar: only the Scripts group is sorted, the others keep the registry's order.
const sections = groups
  .filter((g) => g.id !== 'start')
  .map((g) => {
    const items = pages.filter((p) => p.group === g.id);
    if (g.id === 'scripts') items.sort(byLabel);
    return { ...g, items };
  })
  .filter((s) => s.items.length > 0);

const coverOf = (page) => covers[`../assets/covers/${page.file}.jpg`]?.default;
// The first row of a grid is what a visitor sees without scrolling; the other covers wait until needed.
const EAGER = 4;
---

{
  sections.map((section) => (
    <section class="kit-cat not-content">
      <h2>
        {section.label}
        {section.id === 'scripts' && <small>{section.items.length} resources, A to Z</small>}
      </h2>
      <div class="kit-grid">
        {section.items.map((page, index) => {
          const cover = coverOf(page);
          const eager = index < EAGER;
          return (
            <a class="kit-card" href={addressOf(page.file)}>
              {cover ? (
                <Image
                  src={cover}
                  alt=""
                  widths={[280, 420, 560, 720]}
                  sizes="(min-width: 1336px) 297px, (min-width: 1100px) calc((100vw - 102px) / 4), (min-width: 800px) calc((100vw - 84px) / 3), (min-width: 420px) calc((100vw - 50px) / 2), calc(100vw - 32px)"
                  loading={eager ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <span class="kit-nocover">
                  <svg viewBox="0 0 400 440" aria-hidden="true">
                    <polygon points="200,12 380.1,116 380.1,324 200,428 19.9,324 19.9,116" />
                  </svg>
                </span>
              )}
              <b>{page.label}</b>
            </a>
          );
        })}
      </div>
    </section>
  ))
}
